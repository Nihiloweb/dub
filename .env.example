##############################################
# Coolify / Docker Compose — Nihiloweb Dub MVP
# Copy to .env (never commit secrets)
##############################################

# --- Domains (BUILD-TIME for NEXT_PUBLIC_* — pass as Docker build args too) ---
# Bare hostnames only (no https://)
NEXT_PUBLIC_APP_DOMAIN=dub.example.com
NEXT_PUBLIC_APP_SHORT_DOMAIN=link.example.com
# Partner Program host (middleware → partners UI). Leave empty to use partners.dub.co defaults.
NEXT_PUBLIC_PARTNERS_DOMAIN=go.example.com

# App URL (scheme matters for secure auth cookies)
NEXTAUTH_URL=https://dub.example.com

# Secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# MySQL root password (must be non-empty for ps-http-sim / PlanetScale HTTP shim)
DB_ROOT_PASSWORD=change-me-strong-password

# Invented shared secret for serverless-redis-http (not a real Upstash credential)
UPSTASH_REDIS_REST_TOKEN=change-me-upstash-token

# Optional: prebuilt image tag (Coolify / GHCR). Leave empty for local override build.
# DUB_IMAGE=ghcr.io/nihiloweb/dub:latest
DUB_PORT=3000

# --- Auth (at least one method) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Or email via Resend:
RESEND_API_KEY=

# --- Storage (MinIO optional — needed for avatars / custom OG images) ---
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BASE_URL=https://assets.example.com
STORAGE_PUBLIC_BUCKET=dub-public
STORAGE_PRIVATE_BUCKET=dub-private
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Session analytics API rate limit (requests per second, authenticated UI only).
# Default in code is 120 if unset. Raise if the analytics dashboard still 429s.
ANALYTICS_SESSION_RATE_LIMIT=120

# --- Stubbed for MVP (leave empty / unset unless you wire real services) ---
TINYBIRD_API_KEY=
TINYBIRD_API_URL=https://api.tinybird.co
QSTASH_TOKEN=unset
STRIPE_SECRET_KEY=sk_unset
